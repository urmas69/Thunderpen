{
  "manifest_version": 2,
  "name": "Thunderpen",
  "version": "1.1.3.1",
  "description": "A TinyMCE-powered rich editor for Thunderbird: works in compose window and signature editor, with tables, format painter, and multilingual UI.",
  "author": "Thunderpen Contributors",
  "homepage_url": "https://github.com/kencncmis-spec/Thunderpen",
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderpen@thunderbird-addons.opensource",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "permissions": [
    "compose",
    "storage",
    "accountsRead",
    "accountsIdentities",
    "messagesRead"
  ],
  "web_accessible_resources": [
    "tinymce/*",
    "tinymce/js/tinymce/*",
    "tinymce/js/tinymce/plugins/*",
    "tinymce/js/tinymce/themes/*",
    "tinymce/js/tinymce/icons/*",
    "tinymce/js/tinymce/models/*",
    "tinymce/js/tinymce/langs/*",
    "compose/*",
    "compose/page-init.js",
    "options/*",
    "signature/*",
    "icons/*"
  ]
}
